.cache-web-live/
.cache-web-live-phase2/
.gitlineage-cache/
live-out.txt
gitconfig-absent
*.log
.DS_Store
Thumbs.db
.env
.env.*
# Deployment environment. The runbook tells operators to copy
# gitlineage.env.example to gitlineage.env on the host; that file holds real
# values and must never be committed. Only the .example is tracked.
gitlineage.env