{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitlineage.dev/schemas/lineage-graph-1.0.0.json",
  "title": "GitLineage canonical lineage graph",
  "description": "Machine-readable provenance graph. Entity, Relationship and Evidence are three separate object kinds and are never merged. Every relationship must reference at least one evidence record. Schema 2.0.0 replaced contains_exact_content_from with the symmetric shares_exact_content_with and moved git_blob_identity keys from source_*/target_* to first_*/second_*; a 1.x artifact is not valid under this schema.",
  "x-schema-migrations": {
    "2.0.0": "Breaking: contains_exact_content_from removed (now shares_exact_content_with, symmetric); git_blob_identity evidence keys renamed source_blob/target_blob/source_path/target_path to first_blob/second_blob/first_path/second_path. Artifacts at schemaVersion 1.x are rejected and must be regenerated."
  },
  "type": "object",
  "required": ["schemaVersion", "graph", "entities", "relationships", "evidence", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Must equal the schema version this build produces. A 1.x value is rejected so a pre-rename artifact can never be reused under the current contract.",
      "const": "2.0.0"
    },
    "graph": {
      "type": "object",
      "required": ["rootEntityId", "provider", "revision", "generatedAt", "analyzer"],
      "additionalProperties": false,
      "properties": {
        "rootEntityId": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "revision": {
          "type": "object",
          "required": ["commit", "resolvedAt"],
          "additionalProperties": false,
          "properties": {
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "ref": { "type": "string" },
            "defaultBranch": { "type": "string" },
            "resolvedAt": { "type": "string", "format": "date-time" }
          }
        },
        "analyzer": {
          "type": "object",
          "required": ["name", "version", "schemaVersion", "namespace", "extractors", "adapters"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "schemaVersion": { "type": "string" },
            "namespace": { "enum": ["public", "private"] },
            "extractors": { "type": "array", "items": { "type": "string" } },
            "adapters": { "type": "array", "items": { "type": "string" } },
            "limitsApplied": { "type": "object" }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "display", "attributes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "enum": ["Repository", "Package", "Commit", "Release", "SourceArtifact", "ExternalProject"]
          },
          "display": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "fullName": { "type": "string" },
              "url": { "type": "string" }
            }
          },
          "attributes": { "type": "object" },
          "sourceUrl": { "type": "string" }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "source", "target", "directed", "status", "evidenceIds", "attributes"],
        "additionalProperties": false,
        "allOf": [
          {
            "description": "Symmetric relationship types must never be serialised as directed.",
            "if": {
              "properties": { "type": { "enum": ["shares_history_with", "shares_exact_content_with", "similar_to"] } },
              "required": ["type"]
            },
            "then": {
              "properties": { "directed": { "const": false } }
            }
          },
          {
            "description": "Directional relationship types must always be serialised as directed.",
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "forked_from",
                    "derived_from",
                    "depends_on",
                    "uses_submodule",
                    "declared_inspiration",
                    "references",
                    "evolved_into"
                  ]
                }
              },
              "required": ["type"]
            },
            "then": {
              "properties": { "directed": { "const": true } }
            }
          }
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^rel_[0-9a-f]{16}$" },
          "type": {
            "description": "For symmetric types (shares_history_with, shares_exact_content_with, similar_to) `directed` MUST be false: neither endpoint is the origin.",
            "enum": [
              "forked_from",
              "derived_from",
              "shares_history_with",
              "depends_on",
              "uses_submodule",
              "declared_inspiration",
              "references",
              "shares_exact_content_with",
              "similar_to",
              "evolved_into"
            ]
          },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "directed": {
            "type": "boolean",
            "description": "Copied from the ontology's direction contract, not from the observed endpoint order."
          },
          "status": { "enum": ["VERIFIED", "DECLARED", "DETECTED"] },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^ev_[0-9a-f]{16}$" }
          },
          "attributes": { "type": "object" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "status", "collector", "extractor", "data", "observedAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ev_[0-9a-f]{16}$" },
          "type": {
            "enum": [
              "github_repository_identity",
              "github_fork_metadata",
              "git_shared_commits",
              "git_history_containment",
              "git_blob_identity",
              "git_submodule_entry",
              "package_manifest",
              "package_lockfile",
              "package_registry_metadata",
              "document_attribution",
              "document_reference",
              "token_fingerprint"
            ]
          },
          "status": { "enum": ["VERIFIED", "DECLARED", "DETECTED"] },
          "collector": { "type": "string", "minLength": 1 },
          "extractor": { "type": "string", "minLength": 1 },
          "repository": { "type": "string" },
          "sourceUrl": { "type": "string" },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "lineStart": { "type": "integer", "minimum": 1 },
              "lineEnd": { "type": "integer", "minimum": 1 },
              "field": { "type": "string" },
              "spec": { "type": "string" }
            }
          },
          "observedText": { "type": "string" },
          "data": { "type": "object" },
          "observedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "level", "message"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "level": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string" },
          "collector": { "type": "string" },
          "context": { "type": "object" }
        }
      }
    }
  }
}
