{
  "name": "gitlineage",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Evidence-backed repository lineage and software provenance explorer (V1 provenance core).",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web-scripts.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "serve": "node src/web/serve.ts",
    "serve:api-only": "node src/web/serve.ts --no-client",
    "build": "node build.mjs",
    "start": "node build.mjs && node src/web/serve.ts --client dist/web",
    "test:live": "node test/live/run-live-validation.ts",
    "test:web": "node test/web/live-phase2-validation.ts",
    "test:canvas": "node test/web/canvas-acceptance.ts",
    "shots": "node build.mjs && node test/web/screenshots.ts",
    "analyze": "node src/cli/main.ts analyze",
    "check": "npm run typecheck && npm test",
    "test:ui-contract": "node test/web/ui-contract.ts",
    "test:landing": "node test/web/landing-acceptance.ts",
    "test:analysis": "node test/web/analysis-acceptance.ts && node test/web/analysis-indicator-acceptance.ts",
    "test:preflight": "node test/web/preflight-acceptance.ts",
    "test:responsive": "node test/web/responsive-acceptance.ts",
    "test:mobile": "node test/web/mobile-acceptance.ts && node test/web/initial-neighborhood-acceptance.ts",
    "test:stale": "node test/web/stale-acceptance.ts && node test/web/navigation-loading-acceptance.ts && node test/web/history-state-closeout.ts",
    "preview:deep": "node experiments/discovery-v2/serve-preview.ts",
    "test:deep-search": "node test/web/deep-search-acceptance.ts",
    "preview:private-beta": "node experiments/discovery-v2/serve-private-beta.ts",
    "test:private-beta": "node test/web/private-beta-acceptance.ts",
    "test:private-beta-tls": "bash test/staging/run.sh",
    "test:exploration": "node test/web/public-exploration-acceptance.ts && node test/web/discovery-throttle-acceptance.ts",
    "preview:workspace": "node test/web/workspace-preview.ts",
    "preview:public": "GITLINEAGE_CACHE=\"$HOME/.local/state/gitlineage-public-preview/cache\" GITLINEAGE_JOB_STORE=\"$HOME/.local/state/gitlineage-public-preview/jobs\" GITLINEAGE_PUBLIC_EXPLORATION=1 node src/web/serve.ts --host 127.0.0.1 --port 8084 --client dist/web",
    "test:unification": "node test/web/unification-acceptance.ts && node test/web/history-loading-acceptance.ts && node test/web/component-motion-acceptance.ts && node test/web/site-language-acceptance.ts && node test/web/surface-modules-acceptance.ts && node test/web/hierarchy-refinement-acceptance.ts && node test/web/workflow-hierarchy-acceptance.ts && node test/web/relationship-reading-acceptance.ts && node test/web/history-controls-acceptance.ts && node test/web/design-closeout-acceptance.ts && node test/web/motion-continuity-acceptance.ts && node test/web/overview-acceptance.ts",
    "test:spatial-routing": "node test/web/spatial-routing-acceptance.ts",
    "test:history-return": "node test/web/history-return-acceptance.ts",
    "test:site-continuity": "node test/web/site-continuity-acceptance.ts && npm run test:history-return",
    "test:discovery-v3": "node --test test/discovery/representative-selection.test.ts test/discovery/discovery-v3.test.ts",
    "benchmark:discovery": "node experiments/discovery-v3/benchmark.ts",
    "test:discovery-v3-browser": "node test/web/discovery-v3-acceptance.ts",
    "benchmark:discovery-v4": "node experiments/discovery-v4/benchmark.ts",
    "test:discovery-v4-browser": "node test/web/discovery-v4-acceptance.ts",
    "benchmark:discovery-admission": "node experiments/discovery-admission/benchmark.ts",
    "test:discovery-admission-browser": "node test/web/discovery-admission-acceptance.ts"
  },
  "dependencies": {
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
